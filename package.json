{
  "name": "@von-development-studio/primeng-helper",
  "version": "0.0.0",
  "description": "PrimeNG Helper wrapper.",
  "repository": {
    "type": "git",
    "url": "https://github.com/VON-Development-Studio/primeng-helper"
  },
  "keywords": [
    "angular",
    "primeng"
  ],
  "author": "Luis García Castro",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve example",
    "build": "ng build",
    "build:lib": "ng build --configuration production primeng-helper",
    "watch": "ng build --watch --configuration development",
    "test": "ng test primeng-helper",
    "test:demo": "ng test example",
    "publish:rel": "cd dist/primeng-helper && npm publish --tag latest --access public",
    "publish:snapshot": "cd dist/primeng-helper && npm publish --tag snapshot --access public"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/common": "^21.2.10",
    "@angular/compiler": "^21.2.10",
    "@angular/core": "^21.2.10",
    "@angular/forms": "^21.2.10",
    "@angular/platform-browser": "^21.2.10",
    "@angular/platform-browser-dynamic": "^21.2.10",
    "@angular/router": "^21.2.10",
    "@primeuix/themes": "2.0.2",
    "@tailwindcss/postcss": "^4.1.18",
    "postcss": "^8.5.6",
    "primeicons": "^7.0.0",
    "primeng": "~21.1.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.4",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cdk": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.10",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.3",
    "typescript": "~5.9.3"
  }
}
